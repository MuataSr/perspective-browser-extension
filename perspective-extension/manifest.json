{
  "manifest_version": 3,
  "name": "Perspective",
  "version": "0.8.0",
  "description": "A critical thinking coach for web articles — powered by a small on-device AI model. Private, no API key, works offline.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "settings.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/Readability.js",
        "settings.html",
        "settings.css",
        "settings.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
